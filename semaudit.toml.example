# Role -> model routing. Copy to semaudit.toml in the folder you run semaudit from (with a .env holding the keys).
# [roles] and [providers] are read (src/semaudit/models/router.py). A role left out here uses the router's default.
#
# These are the settings the recorded runs used (README, "Models (measured)"):
#   Northbound and Finablo reviews: Muse Spark 1.3 / 1.2 on the Meta Model API (the router's defaults, repeated below).
#   Spree reviews, and every reusable-check conversion and judgment: Muse Spark Open on Baseten.
# Every role in one model family means a second pass is not independent: confidence is capped at medium.
#
# Built-in providers: "meta" (META_MODEL_API_KEY), "baseten" (BASETEN_API_KEY) and "anthropic" (ANTHROPIC_API_KEY,
# needs the [anthropic] extra). Another OpenAI-compatible endpoint is added under [providers] (end of this file).
# Optional per role: reasoning_effort, max_completion_tokens, unreadable_retries.

# ---- release review: Meta Model API ----

[roles.extractor]                # messages, directives and claims out of each capture
provider = "meta"
model = "muse-spark-1.3"
reasoning_effort = "low"

[roles.interpreter]              # judges candidate conflicts against the rules; in --reader mode, reads everything
provider = "meta"
model = "muse-spark-1.3"
reasoning_effort = "medium"

[roles.cross_checker_extract]    # second pass over the extraction
provider = "meta"
model = "muse-spark-1.2"
reasoning_effort = "low"

[roles.cross_checker_interpret]  # second pass over the interpretation
provider = "meta"
model = "muse-spark-1.2"
reasoning_effort = "medium"

[roles.defender]                 # argues against every issue occurrence
provider = "meta"
model = "muse-spark-1.2"
reasoning_effort = "medium"

# For the Spree setup, give each review role above provider = "baseten" and
# model = "meta-models/muse-spark-open-1026" (the hackathon's open-weights ID), keeping its reasoning_effort.

# ---- reusable checks: Muse Spark Open on Baseten (these roles have no default) ----

[roles.importer]                 # drafts a check's journey and rule from a finding
provider = "baseten"
model = "meta-models/muse-spark-open-1026"
reasoning_effort = "medium"

[roles.check_judge]              # the 3 readings of a saved check's rule on each replay
provider = "baseten"
model = "meta-models/muse-spark-open-1026"
reasoning_effort = "medium"
max_completion_tokens = 6000     # a runaway reply stops sooner
unreadable_retries = 3           # up to 4 fresh seeds per reading

# ---- another OpenAI-compatible endpoint (optional; see docs/10-add-your-app.md, "Use another model") ----
# A new name only: meta, baseten and anthropic cannot be redefined. The key stays in .env, never here.
#
# [providers.myhost]
# base_url = "https://llm.example.com/v1"     # semaudit POSTs to {base_url}/chat/completions
# key_env = "MYHOST_API_KEY"                  # sent as "Authorization: Bearer $MYHOST_API_KEY"
# max_completion_tokens = 8000                # optional default reply cap for this provider
#
# [providers.myhost.prices]                   # optional, USD per million tokens [input, output]; without it the
# "my-model" = [0.5, 1.5]                     # ledger records the calls as unpriced, and --max-usd refuses them
#
# [roles.extractor]
# provider = "myhost"
# model = "my-model"
