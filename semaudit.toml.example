# Role -> model routing. Model IDs are UNVERIFIED until the W1 smoke tests pass.
[budget]
max_usd_per_run = 5.0

[targets.northbound]
data = "synthetic"          # fictional data: Contributor-mode endpoints allowed
allow_contributor_mode = true

[targets.finablo]
data = "synthetic"          # synthetic profiles of a real product
allow_contributor_mode = false   # Standard mode only

[roles.extractor]           # messages, directives, claims
provider = "modal"          # or "baseten"
model = "meta-models/muse-spark-open-1026"   # hackathon-specific ID (participant guide)

[roles.interpreter]         # label candidate relations; model_open pass
provider = "meta"
model = "muse-spark-LATEST" # verify the latest official ID (1.2 / 1.3) in W1

[roles.cross_checker_extract]    # re-extract directives with the OTHER model than the extractor
provider = "meta"
model = "muse-spark-LATEST"

[roles.cross_checker_interpret]  # re-label relations with the OTHER model than the interpreter
provider = "modal"
model = "meta-models/muse-spark-open-1026"
# fallback without open-weights hosting: a different Muse Spark version; confidence records "reduced independence"

[roles.defender]            # explain-it-away pass, independent of the interpreter
provider = "modal"
model = "meta-models/muse-spark-open-1026"

[roles.explorer]            # journey repair, onboarding walk
provider = "meta"
model = "muse-spark-LATEST"

[roles.transcriber]
provider = "meta"
model = "muse-voice-transcribe"   # exact ID to confirm in W1
