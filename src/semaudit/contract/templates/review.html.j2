<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Contract review · {{ c.app.name if c.app else "contract" }}</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--ground:#F6F6F3;--panel:#fff;--ink:#15171C;--ink2:#5B606B;--line:#E2E2DC;--ok:#1F5130;--okbg:#E2F1E6;--warn:#7A4E00;--warnbg:#FCEFD6;--bad:#8E2F0E;--badbg:#FBE4DA;}
*{box-sizing:border-box}
body{margin:0;background:var(--ground);color:var(--ink);font:14px/1.5 Inter,system-ui,sans-serif;}
main{max-width:1100px;margin:0 auto;padding:24px 20px 60px;display:flex;flex-direction:column;gap:18px;}
h1{margin:0;font-size:22px} h2{margin:8px 0 0;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink2)}
.mono,code{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12.5px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:16px 18px;display:flex;flex-direction:column;gap:8px}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.spread{justify-content:space-between}
.pill{font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;border:1px solid var(--line);color:var(--ink2);background:#fff}
.quote{font-size:15px;line-height:1.55}
.muted{color:var(--ink2);font-size:13px}
.st{font-size:12px;font-weight:700;padding:3px 8px;border-radius:6px}
.st.approved{background:var(--okbg);color:var(--ok)} .st.changed{background:var(--badbg);color:var(--bad)} .st.unapproved{background:var(--warnbg);color:var(--warn)}
.cond{display:grid;grid-template-columns:52px 1fr;gap:6px;font-size:14px}
.box{border:1px solid var(--line);border-radius:8px;padding:10px 12px;background:#FAFAF7}
table{border-collapse:collapse;width:100%;font-size:13px} th,td{text-align:left;padding:7px 8px;border-top:1px solid var(--line);vertical-align:top} th{color:var(--ink2);font-weight:600;border-top:none}
button{font:600 13px Inter,sans-serif;padding:7px 12px;border-radius:7px;border:1px solid var(--ink);background:var(--ink);color:#fff;cursor:pointer}
.problems{border-color:#E9B8A5;background:#FFF7F3}
@media (max-width:640px){.cond{grid-template-columns:46px 1fr}}
</style>
</head>
<body>
{% macro state(key) -%}
  <span class="row" style="gap:8px">
    <span class="st {{ status[key] }}">{{ status[key] }}{% if status[key] == "approved" %} · {{ approvals[key].by }} {{ approvals[key].date }}{% endif %}</span>
    {% if interactive and status[key] != "approved" %}
    <form method="post" action="/approve" style="margin:0"><input type="hidden" name="key" value="{{ key }}"><button type="submit">Approve</button></form>
    {% endif %}
  </span>
{%- endmacro %}
<main id="top">
  <div class="row spread">
    <div>
      <h1>{{ c.app.name if c.app else "Contract" }}: owner rules and product contract</h1>
      <div class="row" style="margin-top:4px">
        <span class="pill">built during the hackathon</span>
        {% if c.app %}<span class="pill">{{ "fictional app" if c.app.fictional else "app under audit" }}</span><span class="pill">data: {{ c.app.data }}</span>{% endif %}
      </div>
    </div>
    <div class="row">
      <span class="muted">{{ counts.approved }} approved · {{ counts.changed }} changed since approval · {{ counts.unapproved }} not yet approved</span>
      {% if interactive and unapproved %}
      <form method="post" action="/approve" style="margin:0">{% for k in unapproved %}<input type="hidden" name="key" value="{{ k }}">{% endfor %}<button type="submit">Approve all {{ unapproved|length }}</button></form>
      {% endif %}
    </div>
  </div>

  {% if problems %}
  <div class="card problems"><strong>This contract has {{ problems|length }} problem(s) and cannot be audited until they are fixed:</strong>
    <ul style="margin:0">{% for p in problems %}<li class="mono">{{ p }}</li>{% endfor %}</ul></div>
  {% endif %}

  <h2>Rules</h2>
  {% for r in c.rules %}
  <section class="card" id="rule-{{ r.id }}">
    <div class="row spread">
      <div class="row"><strong class="mono" style="font-size:15px">{{ r.id }}</strong><span class="pill">{{ r.kind }}</span><span class="pill">severity if violated: {{ r.severity }}</span></div>
      {{ state("rule:" ~ r.id) }}
    </div>
    <div class="quote">“{{ r.text }}”</div>
    <div class="muted">Evaluated by: {{ evaluated_by(r) }}</div>
    {% for e in r.exceptions %}
    <div class="box" id="exception-{{ e.id }}">
      <div class="row spread">
        <div class="row"><strong class="mono">{{ e.id }}</strong><span class="muted">exception to {{ r.id }}: permitted only when <b>all</b> hold</span></div>
        {{ state("exception:" ~ e.id) }}
      </div>
      {% for cond in e.conditions %}
      <div class="cond"><span class="mono">({{ cond.id }})</span><span>{{ describe(cond) }}</span></div>
      {% endfor %}
      <div class="cond"><span class="mono">scope</span><span>{% for k, v in e.scope.items() %}{{ k }}: {{ v|join(", ") }}{% if not loop.last %} · {% endif %}{% endfor %}</span></div>
      <div class="muted">approved by {{ e.approved.by }} on {{ e.approved.date }} · expires {{ e.approved.expires }}</div>
    </div>
    {% endfor %}
  </section>
  {% endfor %}

  <h2>Decisions and actions</h2>
  {% for d in c.decisions %}
  <section class="card" id="decision-{{ d.id }}">
    <div class="row spread"><strong class="mono">{{ d.id }}</strong>{{ state("decision:" ~ d.id) }}</div>
    <div>Actions: {% for a in d.actions %}<code>{{ a }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</div>
    {% for p in d.incompatible %}<div><span class="st changed">incompatible</span> <code>{{ p.pair[0] }}</code> ⟂ <code>{{ p.pair[1] }}</code> <span class="muted">· {{ p.rationale }}</span></div>{% endfor %}
    {% for p in d.tradeoffs %}<div><span class="st unapproved">material tradeoff</span> <code>{{ p.pair[0] }}</code> + <code>{{ p.pair[1] }}</code> <span class="muted">· {{ p.material }}</span></div>{% endfor %}
    {% if d.never_pairs %}<div class="muted">Never forms a pair: {{ d.never_pairs|join(", ") }}</div>{% endif %}
    {% if d.decided_by %}<div class="muted">Settled when the user: {{ d.decided_by|join(" or ") }}</div>{% endif %}
    <div class="muted">Preconditions: {% for a, pre in d.preconditions.items() %}{{ "any action" if a == "*" else a }} needs {% for k, v in pre.items() %}{{ k }} = {{ v }}{% endfor %}{% if not loop.last %} · {% endif %}{% endfor %}</div>
  </section>
  {% endfor %}

  <h2>Features</h2>
  <div class="card">
    <table><tr><th>Feature</th><th>Introduced</th><th>Changed in</th><th>Advice lasts (default)</th><th>Status</th></tr>
    {% for f in c.features %}<tr><td><b>{{ f.name or f.id }}</b> <span class="mono muted">{{ f.id }}</span></td><td>{{ f.release_introduced or "—" }}</td><td>{{ f.changed_in|join(", ") or "—" }}</td>
      <td>{% for ch, h in f.default_lifetime_hours.items() %}{{ ch }} {{ h|int }} h{% if not loop.last %} · {% endif %}{% endfor %}</td><td>{{ state("feature:" ~ f.id) }}</td></tr>{% endfor %}
    </table>
  </div>

  <h2>Subject</h2>
  <section class="card">
    <div class="row spread"><span>The user is called <b>{{ c.subject.noun }}</b>{% if c.subject.component_from %} · an event's component defaults to <code>{{ c.subject.component_from }}</code>{% endif %}</span>{{ state("subject:all") }}</div>
    <table><tr><th>Context field</th><th>Type</th><th>Default</th><th>Shown as</th></tr>
    {% for f in c.subject.context %}<tr><td class="mono">{{ f.id }}{% if f.required %} <span class="pill">required</span>{% endif %}</td><td>{{ f.type }}{% if f.values %} ({{ f.values|join(", ") }}){% endif %}</td><td class="mono">{{ f.default if f.default is not none else "" }}</td><td>{{ f.show if f.show is not none else "" }}</td></tr>{% endfor %}
    </table>
  </section>

  {% if c.personas %}
  <h2>Personas</h2>
  <div class="card">
    <table><tr><th>Persona</th><th>Situation</th><th>Arms / world</th><th>Status</th></tr>
    {% for p in c.personas %}<tr><td><b>{{ p.name }}</b> <span class="mono muted">{{ p.id }}</span>{% if p.role %}<br><span class="muted">{{ p.role }}</span>{% endif %}</td>
      <td class="mono">{% for f in c.subject.context %}{% set v = p.value(f.id, c.subject) %}{% if v is not none %}{{ f.id }}: {{ v }}{% if f.id not in p.context %} <span class="muted">(default)</span>{% endif %}<br>{% endif %}{% endfor %}</td>
      <td class="mono">{% for k, v in p.experiments.items() %}{{ k }}={{ v }}<br>{% endfor %}{% for k, v in p.world.items() %}{{ k }}: {{ v }}<br>{% endfor %}</td>
      <td>{{ state("persona:" ~ p.id) }}</td></tr>{% endfor %}
    </table>
  </div>
  {% endif %}

  {% if c.scenarios %}
  <h2>Scenarios</h2>
  {% for s in c.scenarios %}
  <section class="card" id="scenario-{{ s.id }}">
    <div class="row spread"><div><strong class="mono">{{ s.id }}</strong> <span class="muted">· {{ s.description }} · {{ s.personas|join(", ") }}</span></div>{{ state("scenario:" ~ s.id) }}</div>
    <table>{% for st in s.steps %}<tr><td class="mono" style="width:120px">{{ st.at }}</td><td><code>{{ st.do }}</code>{% for k, v in st.params.items() %} <span class="muted">{{ k }}={{ v }}</span>{% endfor %}{% if st.when_offered %} <span class="pill">only if offered</span>{% endif %}</td></tr>{% endfor %}</table>
  </section>
  {% endfor %}
  {% endif %}

  {% if c.policy %}
  <h2>Release policy</h2>
  <section class="card">
    <div class="row spread"><span class="muted">Evaluated top to bottom; the first row that fires is the recommendation. Exhaustive by construction.</span>{{ state("policy:release") }}</div>
    <table>{% for row in c.policy.rows %}<tr><td class="mono" style="width:30px">{{ loop.index }}</td><td style="width:190px"><b>{{ row.recommendation|replace("_", " ")|capitalize }}</b></td><td>{{ row.text }}</td></tr>{% endfor %}</table>
  </section>
  {% endif %}

  <h2>Evidence model</h2>
  <div class="card">
    {% if c.state %}<div class="row spread"><b>Derived state</b>{{ state("state:all") }}</div>
    <div class="muted">{% for v in c.state %}<code>{{ v.id }}</code>{% if v.kind == "window" %}: true for {{ v.hours|int }} h after {{ v.opens_on }}{% else %}: {{ v.initial }}{% for a, val in v.set_by.items() %} → {{ val }} on {{ a }}{% endfor %}{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
    {% if c.facts %}<div class="row spread" style="margin-top:8px"><b>Facts and oracles</b>{{ state("facts:all") }}</div>
    <div class="muted">{% for f in c.facts %}<code>{{ f.id }}</code> → {% if f.sources %}{% for src in f.sources %}{{ src.oracle }}.{{ src.field }}{% if src.where %}[{% for k, v in src.where.items() %}{{ k }}={{ v }}{% endfor %}].{{ src.take }}{% endif %}{% if not loop.last %} or {% endif %}{% endfor %}{% else %}no oracle (unverifiable, never false){% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
    {% if c.surfaces %}<div class="row spread" style="margin-top:8px"><b>Surfaces</b>{{ state("surfaces:all") }}</div>
    <div class="muted">{% for s in c.surfaces %}<code>{{ s.id }}</code> {{ s.kind }}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
    {% if c.oracles %}<div class="row spread" style="margin-top:8px"><b>Oracle endpoints</b>{{ state("oracles:all") }}</div>
    <div class="muted">{% for o in c.oracles %}<code>{{ o.endpoint }}</code>{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
    {% if c.app %}<div class="row spread" style="margin-top:8px"><b>App and hooks</b>{{ state("app:" ~ c.app.name) }}</div>
    <div class="muted">{{ c.app.base_url }} · releases {{ c.app.releases|join(", ") }} · persona {{ c.app.hooks.persona }} · clock {{ c.app.hooks.clock or "none (time-triggered surfaces not measured)" }}</div>{% endif %}
  </div>
</main>
</body>
</html>
